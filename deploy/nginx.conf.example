# StatLLM Nginx 反向代理配置示例
# 域名: statllm.mcocdaa-newapi.xin -> 127.0.0.1:8008

server {
    listen 80;
    listen 443 ssl;
    http2 on;

    server_name statllm.mcocdaa-newapi.xin;

    # SSL 证书路径（在宝塔面板配置或通过 acme.sh 申请后启用）
    # ssl_certificate        /www/server/panel/vhost/cert/statllm.mcocdaa-newapi.xin/fullchain.pem;
    # ssl_certificate_key    /www/server/panel/vhost/cert/statllm.mcocdaa-newapi.xin/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_ciphers EECDH+CHACHA20:EECDH+CHACHA20-draft:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:EECDH+3DES:RSA+3DES:!MD5;
    # ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:8008;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Real-Port $remote_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header REMOTE-HOST $remote_addr;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # 静态资源长期缓存优化
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:8008;
        proxy_set_header Host $http_host;
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    access_log  /www/wwwlogs/statllm.mcocdaa-newapi.xin.log;
    error_log   /www/wwwlogs/statllm.mcocdaa-newapi.xin.error.log;
}
