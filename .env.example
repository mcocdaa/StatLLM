# StatLLM Environment Configuration Example
# Copy this file to .env and populate with your own credentials if running benchmark scripts.

# OpenRouter API Key (Required for running scripts/onboard_*.py and scripts/expand_*.py)
OPENROUTER_KEY=your_openrouter_api_key_here

# Custom LLM Proxy / Gateway (Optional, if using custom proxy endpoints)
KOALA_KEY=your_proxy_api_key_here
KOALA_URL=https://api.openai.com/v1

# StatLLM Server Configuration
PORT=8008
HOST=0.0.0.0
